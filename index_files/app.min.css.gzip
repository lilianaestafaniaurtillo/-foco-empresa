    font-weight: 300;
    line-height: 1
}

.block.grid-accordions-with-images.alternative-green div.item div.content div {
    padding: 0 40px 25px
}

.block.grid-accordions-with-images div#items {
    align-items: flex-start;
    display: grid;
    gap: 25px
}

.block.grid-accordions-with-images div#items.columns-1 {
    grid-template-columns: repeat(1, 1fr)
}

.block.grid-accordions-with-images div#items.columns-2 {
    grid-template-columns: repeat(2, 1fr)
}

@media(max-width: 991px) {
    .block.grid-accordions-with-images div#items.columns-2 {
        grid-template-columns: repeat(1, 1fr)
    }
}

.block.grid-accordions-with-images div#items.columns-3 {
    grid-template-columns: repeat(3, 1fr)
}

@media(max-width: 991px) {
    .block.grid-accordions-with-images div#items.columns-3 {
        grid-template-columns: repeat(1, 1fr)
    }
}

.block.grid-accordions-with-images div#items div.column {
    display: flex;
    flex-direction: column;
    gap: 25px
}

.block.grid-accordions-with-images div.item {
    display: block
}

.block.grid-accordions-with-images div.item.is-expanded div.title {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0
}

.block.grid-accordions-with-images div.item.is-expanded div.icon img:first-child {
    opacity: 0 !important
}

.block.grid-accordions-with-images div.item.is-expanded div.icon img:last-child {
    opacity: 1 !important
}

.block.grid-accordions-with-images div.item div.title {
    align-items: center;
    box-sizing: border-box;
    cursor: pointer;
    display: flex;
    gap: 25px;
    user-select: none
}

.block.grid-accordions-with-images div.item div.title div.image {
    display: block;
    flex-shrink: 0;
    height: 70px;
    width: 70px
}

.block.grid-accordions-with-images div.item div.title div.image img {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center;
    width: 100%
}

.block.grid-accordions-with-images div.item div.title h5 {
    flex-grow: 1;
    font-family: "poppins", sans-serif
}

.block.grid-accordions-with-images div.item div.title div.icon {
    display: block;
    flex-shrink: 0;
    height: 16px;
    position: relative;
    width: 16px
}

.block.grid-accordions-with-images div.item div.title div.icon img {
    transition: opacity 125ms ease-in-out;
    display: block;
    height: 100%;
    left: 50%;
    object-fit: contain;
    object-position: center;
    position: absolute;
    top: 50%;
    transform: translate3d(-50%, -50%, 0);
    width: 100%
}

.block.grid-accordions-with-images div.item div.title div.icon img:first-child {
    opacity: 1
}

.block.grid-accordions-with-images div.item div.title div.icon img:last-child {
    opacity: 0
}

.block.grid-accordions-with-images div.item div.content {
    pointer-events: none
}

.block.grid-accordions-with-images div.item div.content div {
    box-sizing: border-box
}

.block.grid-accordions-with-images div.item.is-expanded div.content {
    pointer-events: all
}

