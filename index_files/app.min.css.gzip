        font-size: 16px
    }
}

.block.holiday-calendar div.calendar div.month table tbody tr td.bank-holiday {
    background-color: #1a61ab;
    color: #fff;
    font-weight: 700
}

.block.holiday-calendar div.calendar div.month table tbody tr td.national-holiday {
    background-color: #219963;
    color: #fff;
    font-weight: 700
}

.block.holiday-calendar div.calendar div.month table tbody tr:first-child td {
    border-top: 1px solid #dce1e9
}

.block.holiday-calendar ul.legend {
    list-style: none;
    margin: 50px 0;
    padding: 0
}

.block.holiday-calendar ul.legend li+li {
    margin-top: 15px
}

.block.holiday-calendar ul.legend li {
    align-items: center;
    display: flex;
    font-family: "poppins", sans-serif;
    font-size: 20px;
    font-weight: 700;
    gap: 15px;
    line-height: 1
}

.block.holiday-calendar ul.legend li:before {
    content: "";
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: block
}

.block.holiday-calendar ul.legend li.bank-holidays:before {
    background-color: #1a61ab
}

.block.holiday-calendar ul.legend li.national-holidays:before {
    background-color: #219963
}

.block.holiday-calendar div.buttons {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
    margin: 50px 0
}

@media(max-width: 768px) {
    .block.holiday-calendar div.buttons {
        gap: 10px;
        margin: 25px 0
    }
}

.block.holiday-calendar a.button {
    transition: background-color 300ms ease-in-out, color 300ms ease-in-out;
    background-color: #007953;
    border-radius: 500px;
    color: #fff;
    font-family: "poppins", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    padding: 15px 35px;
    text-align: center;
    user-select: none
}

.block.holiday-calendar a.button:hover {
    background-color: #219963
}

.block.holiday-calendar a.button:active {
    background-color: #007953
}

