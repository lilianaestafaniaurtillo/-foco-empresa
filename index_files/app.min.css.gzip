    border-top: 1px solid #dce1e9;
    padding: 25px 40px
}

.block.grid-accordions-with-images.alternative div.item {
    border-radius: 10px;
    border: 1px solid #dce1e9
}

.block.grid-accordions-with-images.alternative div.item div.title {
    padding: 40px
}

