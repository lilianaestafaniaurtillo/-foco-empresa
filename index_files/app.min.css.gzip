.block.recommended-posts {
    background-color: #f5f7fa
}

.block.recommended-posts :first-child {
    margin-top: 0 !important
}

.block.recommended-posts :last-child {
    margin-bottom: 0 !important
}

@media(min-width: 769px) {
    .block.recommended-posts {
        margin: var(--margin-top, 0) 0 var(--margin-bottom, 0) 0;
        padding: var(--padding-top, 0) 0 var(--padding-bottom, 0) 0
    }
}

@media(max-width: 768px) {
    .block.recommended-posts {
        margin: var(--margin-top-mobile, 0) 0 var(--margin-bottom-mobile, 0) 0;
        padding: var(--padding-top-mobile, 0) 0 var(--padding-bottom-mobile, 0) 0
    }
}

.block.recommended-posts h1,
.block.recommended-posts p {
    font-family: "poppins", sans-serif
}

.block.recommended-posts h1 {
    color: #3a4454;
    font-size: 40px;
    font-weight: 300;
    line-height: 1;
    margin: 75px 0;
    text-align: center
}

@media(max-width: 991px) {
    .block.recommended-posts h1 {
        font-size: 36px;
        margin: 50px 0
    }
}

.block.recommended-posts div.grid {
    display: grid;
    grid-column-gap: 35px;
    grid-row-gap: 35px;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: 1fr
}

@media(max-width: 991px) {
    .block.recommended-posts div.grid {
        grid-template-columns: repeat(1, 1fr);
        grid-column-gap: 15px;
        grid-row-gap: 15px
    }
}

.block.recommended-posts a.post {
    transition: box-shadow 250ms ease-in-out;
    align-items: flex-start;
    background-color: #fff;
    border-radius: 10px;
    border: 1px solid #dce1e9;
    display: flex;
    overflow: hidden
}

@media(max-width: 768px) {
    .block.recommended-posts a.post {
        flex-direction: column
    }
}

.block.recommended-posts a.post:hover {
    box-shadow: 0 5px 30px rgba(15, 35, 52, .15)
}

.block.recommended-posts a.post div.image {
    flex-grow: 0;
    flex-shrink: 0;
    align-self: stretch;
    display: block
}

.block.recommended-posts a.post div.image img {
    display: block;
    width: 235px;
    height: 260px;
    object-fit: cover;
    object-position: center
}

@media(max-width: 768px) {
    .block.recommended-posts a.post div.image img {
        width: 100%;
        height: 235px
    }
}

.block.recommended-posts a.post div.details {
    padding: 25px;
    box-sizing: border-box
}

.block.recommended-posts a.post p.date {
    color: #4a5264;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.5;
    text-transform: uppercase
}

.block.recommended-posts a.post h4 {
    color: #219963;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
    margin: 15px 0 25px
}

.block.recommended-posts a.post p.excerpt {
    color: #4a5264;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    max-width: 100%
}

.block.simple-bordered-text-with-image :first-child {
    margin-top: 0 !important
}

.block.simple-bordered-text-with-image :last-child {
    margin-bottom: 0 !important
}

.block.simple-bordered-text-with-image .formatted-text :first-child {
    margin-top: 0 !important
}

.block.simple-bordered-text-with-image .formatted-text :last-child {
    margin-bottom: 0 !important
}

.block.simple-bordered-text-with-image .formatted-text h1 {
    font-size: 40px;
    font-weight: 300
}

.block.simple-bordered-text-with-image .formatted-text h2 {
    font-size: 34px;
    font-weight: 300
}

.block.simple-bordered-text-with-image .formatted-text h3 {
    font-size: 30px;
    font-weight: 300
}

.block.simple-bordered-text-with-image .formatted-text h4,
.block.simple-bordered-text-with-image .formatted-text h5 {
    font-size: 20px;
    font-weight: 700
}

.block.simple-bordered-text-with-image .formatted-text h6 {
    font-size: 16px;
    font-weight: 700
}

.block.simple-bordered-text-with-image .formatted-text h1,
.block.simple-bordered-text-with-image .formatted-text h2,
.block.simple-bordered-text-with-image .formatted-text h3,
.block.simple-bordered-text-with-image .formatted-text h4,
.block.simple-bordered-text-with-image .formatted-text h5,
.block.simple-bordered-text-with-image .formatted-text h6 {
    color: #3a4454
}

.block.simple-bordered-text-with-image .formatted-text h1,
.block.simple-bordered-text-with-image .formatted-text h2,
.block.simple-bordered-text-with-image .formatted-text h3,
.block.simple-bordered-text-with-image .formatted-text h4,
.block.simple-bordered-text-with-image .formatted-text h5,
.block.simple-bordered-text-with-image .formatted-text h6,
.block.simple-bordered-text-with-image .formatted-text ol,
.block.simple-bordered-text-with-image .formatted-text ul,
.block.simple-bordered-text-with-image .formatted-text p {
    margin: 1em 0
}

.block.simple-bordered-text-with-image .formatted-text blockquote {
    font-size: 16px;
    color: #4a5264;
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    margin: 1em 0;
    padding-left: 2em;
    border-left: 5px solid #dce1e9
}

.block.simple-bordered-text-with-image .formatted-text ul.is-spaced li+li,
.block.simple-bordered-text-with-image .formatted-text ol.is-spaced li+li {
    margin-top: 1em
}

.block.simple-bordered-text-with-image .formatted-text ul,
.block.simple-bordered-text-with-image .formatted-text menu,
.block.simple-bordered-text-with-image .formatted-text dir {
    display: block;
    line-height: 1.5;
    list-style-type: disc;
    margin-block-end: 1em;
    margin-block-start: 1em;
    margin-inline-end: 0px;
    margin-inline-start: 0px;
    padding-inline-start: 30px
}

.block.simple-bordered-text-with-image .formatted-text ol {
    display: block;
    line-height: 1.5;
    list-style-type: decimal;
    margin-block-end: 1em;
    margin-block-start: 1em;
    margin-inline-end: 0px;
    margin-inline-start: 0px;
    padding-inline-start: 30px
}

.block.simple-bordered-text-with-image .formatted-text p,
.block.simple-bordered-text-with-image .formatted-text li {
    color: #4a5264;
    font-family: "poppins", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5
}

.block.simple-bordered-text-with-image .formatted-text p a:not(.button),
.block.simple-bordered-text-with-image .formatted-text li a:not(.button) {
    color: #219963;
    display: inline-block;
    font-weight: 700;
    position: relative
}

.block.simple-bordered-text-with-image .formatted-text p a:not(.button):after,
.block.simple-bordered-text-with-image .formatted-text li a:not(.button):after {
    transition: opacity 125ms ease-in-out, visibility 125ms ease-in-out;
    border-bottom: 1.5px solid #219963;
    bottom: 0;
    content: "";
    display: block;
    height: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transform: translate3d(0, 0, 0);
    visibility: hidden;
    width: 100%
}

.block.simple-bordered-text-with-image .formatted-text p a:not(.button):hover:after,
