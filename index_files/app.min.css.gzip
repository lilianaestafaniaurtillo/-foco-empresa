.block.tabs * {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale
}

.block.tabs :first-child {
    margin-top: 0 !important
}

.block.tabs :last-child {
    margin-bottom: 0 !important
}

@media(min-width: 769px) {
    .block.tabs {
        margin: var(--margin-top, 0) 0 var(--margin-bottom, 0) 0;
        padding: var(--padding-top, 0) 0 var(--padding-bottom, 0) 0
    }
}

@media(max-width: 768px) {
    .block.tabs {
        margin: var(--margin-top-mobile, 0) 0 var(--margin-bottom-mobile, 0) 0;
        padding: var(--padding-top-mobile, 0) 0 var(--padding-bottom-mobile, 0) 0
    }
}

.block.tabs div#tabs {
    margin: 50px 0;
    position: relative
}

.block.tabs div#tabs ul[data-triggers] {
    background-color: #f5f5f5;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border: 1px solid #dce1e9;
    display: flex;
    list-style: none;
    margin: 0;
    overflow: auto;
    padding: 0
}

.block.tabs div#tabs ul[data-triggers] li[data-index] {
    transition: background-color 125ms ease-in-out, color 125ms ease-in-out;
    cursor: pointer;
    flex-grow: 1;
    padding: 15px 30px;
    text-align: center;
    user-select: none;
    white-space: nowrap;
    color: #708090;
    font-weight: 700
}

.block.tabs div#tabs ul[data-triggers] li[data-index]:hover,
.block.tabs div#tabs ul[data-triggers] li[data-index].is-selected {
    background-color: #fff;
    color: #219963
}

.block.tabs div#tabs ul[data-triggers] li+li {
    border-left: 1px solid #dce1e9
}

.block.tabs div#tabs ul[data-tabs] {
    width: 100%;
    list-style: none;
    margin: 0;
    border-bottom: 1px solid #dce1e9;
    border-left: 1px solid #dce1e9;
    border-right: 1px solid #dce1e9;
    position: relative;
    overflow: hidden
}

.block.tabs div#tabs ul[data-tabs] li[data-index] {
    transition: opacity 125ms linear, visibility 125ms linear;
    opacity: 0;
    overflow-x: auto;
    overflow-y: hidden;
    pointer-events: none;
    pointer-events: none;
    position: absolute;
    top: 0;
    visibility: hidden;
    width: 100%
}

.block.tabs div#tabs ul[data-tabs] li[data-index].is-selected {
    opacity: 1;
    pointer-events: all;
    pointer-events: all;
    position: relative;
    visibility: visible
}

.block.tabs .is-responsive-16-9 {
    height: 0;
    padding-bottom: 56.25%;
    position: relative
}

.block.tabs .is-responsive-16-9>* {
    border: 0;
    display: block;
    height: 100%;
    left: 0;
    object-fit: cover;
    object-position: center center;
    position: absolute;
    top: 0;
    width: 100%
}

.block.tabs .has-full-width {
    width: 100%;
    display: block;
    height: auto
}

