.block.text-content-with-sidebar .formatted-text h6 {
    color: #3a4454
}

.block.text-content-with-sidebar .formatted-text h1,
.block.text-content-with-sidebar .formatted-text h2,
.block.text-content-with-sidebar .formatted-text h3,
.block.text-content-with-sidebar .formatted-text h4,
.block.text-content-with-sidebar .formatted-text h5,
.block.text-content-with-sidebar .formatted-text h6,
.block.text-content-with-sidebar .formatted-text ol,
.block.text-content-with-sidebar .formatted-text ul,
.block.text-content-with-sidebar .formatted-text p {
    margin: 1em 0
}

.block.text-content-with-sidebar .formatted-text blockquote {
    font-size: 16px;
    color: #4a5264;
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    margin: 1em 0;
    padding-left: 2em;
    border-left: 5px solid #dce1e9
}

.block.text-content-with-sidebar .formatted-text ul.is-spaced li+li,
.block.text-content-with-sidebar .formatted-text ol.is-spaced li+li {
    margin-top: 1em
}

.block.text-content-with-sidebar .formatted-text ul,
.block.text-content-with-sidebar .formatted-text menu,
.block.text-content-with-sidebar .formatted-text dir {
    display: block;
    line-height: 1.5;
    list-style-type: disc;
    margin-block-end: 1em;
    margin-block-start: 1em;
    margin-inline-end: 0px;
    margin-inline-start: 0px;
    padding-inline-start: 30px
}

.block.text-content-with-sidebar .formatted-text ol {
    display: block;
    line-height: 1.5;
    list-style-type: decimal;
    margin-block-end: 1em;
    margin-block-start: 1em;
    margin-inline-end: 0px;
    margin-inline-start: 0px;
    padding-inline-start: 30px
}

.block.text-content-with-sidebar .formatted-text p,
.block.text-content-with-sidebar .formatted-text li {
    color: #4a5264;
    font-family: "poppins", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5
}

.block.text-content-with-sidebar .formatted-text p a:not(.button),
.block.text-content-with-sidebar .formatted-text li a:not(.button) {
    color: #219963;
    display: inline-block;
    font-weight: 700;
    position: relative
}

.block.text-content-with-sidebar .formatted-text p a:not(.button):after,
.block.text-content-with-sidebar .formatted-text li a:not(.button):after {
    transition: opacity 125ms ease-in-out, visibility 125ms ease-in-out;
    border-bottom: 1.5px solid #219963;
    bottom: 0;
    content: "";
    display: block;
    height: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transform: translate3d(0, 0, 0);
    visibility: hidden;
    width: 100%
}

.block.text-content-with-sidebar .formatted-text p a:not(.button):hover:after,
.block.text-content-with-sidebar .formatted-text li a:not(.button):hover:after {
    opacity: 1;
    visibility: visible
}

