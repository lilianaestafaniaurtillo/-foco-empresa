        margin: var(--margin-top-mobile, 0) 0 var(--margin-bottom-mobile, 0) 0;
        padding: var(--padding-top-mobile, 0) 0 var(--padding-bottom-mobile, 0) 0
    }
}

.block.sliding-tabs div.swiper {
    overflow: visible;
    position: relative
}

.block.sliding-tabs div.swiper:before,
.block.sliding-tabs div.swiper:after {
    content: "";
    height: 100%;
    pointer-events: all;
    position: absolute;
    top: 0;
    width: 50vw;
    z-index: 5
}

.block.sliding-tabs div.swiper:before {
    background: linear-gradient(to right, rgba(255, 255, 255, 0.75) 50%, rgba(255, 255, 255, 0) 100%);
    right: 100%
}

.block.sliding-tabs div.swiper:after {
    background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.75) 50%);
    left: 100%
}

.block.sliding-tabs div.swiper div.next,
.block.sliding-tabs div.swiper div.previous {
    transition: box-shadow 125ms ease-in-out, opacity 125ms ease-in-out;
    background-color: #fff;
    border-radius: 50%;
    box-shadow: 0px 4px 15px rgba(26, 97, 171, .1);
    cursor: pointer;
    height: 50px;
    opacity: 1;
    position: absolute;
    top: 50%;
    transform: translate3d(0, -50%, 0);
    user-select: none;
    width: 50px;
    z-index: 10
}

.block.sliding-tabs div.swiper div.next:hover,
.block.sliding-tabs div.swiper div.previous:hover {
    box-shadow: 0px 4px 15px rgba(26, 97, 171, .2)
}

.block.sliding-tabs div.swiper div.next[aria-disabled=true],
.block.sliding-tabs div.swiper div.previous[aria-disabled=true] {
    opacity: 0;
    pointer-events: none
}

.block.sliding-tabs div.swiper div.next img,
.block.sliding-tabs div.swiper div.previous img {
    display: block;
    height: 55%;
    left: 50%;
    object-fit: contain;
    position: absolute;
    top: 50%;
    width: 55%
}

@media(max-width: 768px) {

    .block.sliding-tabs div.swiper div.next,
    .block.sliding-tabs div.swiper div.previous {
        display: none !important
    }
}

.block.sliding-tabs div.swiper div.next {
    right: -25px
}

.block.sliding-tabs div.swiper div.next img {
    transform: translate3d(calc(-50% + 2px), -50%, 0)
}

@media(max-width: 991px) {
    .block.sliding-tabs div.swiper div.next {
        right: 0
    }
}

.block.sliding-tabs div.swiper div.previous {
    left: -25px
}

.block.sliding-tabs div.swiper div.previous img {
    transform: translate3d(calc(-50% - 2px), -50%, 0)
}

@media(max-width: 991px) {
    .block.sliding-tabs div.swiper div.previous {
        left: 0
    }
}

