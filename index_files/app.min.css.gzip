}

.faq-accordion-new__question {
    color: #007953;
    font-size: 30px;
    font-weight: 300;
    line-height: 100%;
    cursor: pointer;
    border-bottom: 1px solid #dce1e9;
    transition: .3s ease-in-out;
    transition-delay: .3s
}

@media(min-width: 769px) {
