        padding: var(--padding-top) 0 var(--padding-bottom) 0;
        margin: var(--margin-top) 0 var(--margin-bottom) 0
    }
}

@media(max-width: 768px) {
    .logo-dropdown-new {
        padding: var(--padding-top--mobile) 0 var(--padding-bottom--mobile) 0;
        margin: var(--margin-top--mobile) 0 var(--margin-bottom--mobile) 0
    }
}

.logo-dropdown-new__section-title {
    color: #3a4454;
    text-align: center;
    font-size: 40px;
    font-weight: 300;
    line-height: 100%;
    margin-bottom: 72px
}

.logo-dropdown-new__items {
    display: grid;
    align-items: start;
    gap: 40px 24px
}

@media(min-width: 1201px) {
    .logo-dropdown-new__items {
        grid-template-columns: repeat(3, 1fr)
    }
}

@media(max-width: 1200px) {
    .logo-dropdown-new__items {
        grid-template-columns: repeat(2, 1fr)
    }
}

@media(max-width: 991px) {
    .logo-dropdown-new__items {
        grid-template-columns: repeat(1, 1fr);
        gap: 24px
    }
}

.logo-dropdown-new__items.bottom-border {
    border-bottom: 1px solid #dce1e9
}

@media(min-width: 769px) {
    .logo-dropdown-new__items.bottom-border {
        padding-bottom: 112px
    }
}

@media(max-width: 768px) {
    .logo-dropdown-new__items.bottom-border {
        padding-bottom: 50px
    }
}

.logo-dropdown-new__item {
    border-radius: 10px;
    border: 1px solid #dce1e9
}

.logo-dropdown-new__item:hover .logo-dropdown-new__header:after {
    transform: rotate(180deg)
}

.logo-dropdown-new__item:hover .logo-dropdown-new__body {
    max-height: 2000px;
    border-top: 1px solid #dce1e9
}

@media(min-width: 769px) {
    .logo-dropdown-new__item:hover .logo-dropdown-new__body {
        padding: 25px 36px 36px 36px
    }
}

@media(max-width: 768px) {
    .logo-dropdown-new__item:hover .logo-dropdown-new__body {
        padding: 16px
    }
}

.logo-dropdown-new__header {
    display: flex;
    align-items: center;
    position: relative;
    cursor: pointer
}

@media(min-width: 769px) {
    .logo-dropdown-new__header {
        padding: 24px 64px 24px 40px;
        gap: 24px
    }
}

@media(max-width: 768px) {
    .logo-dropdown-new__header {
        padding: 16px 64px 16px 16px;
        gap: 16px
    }
}

.logo-dropdown-new__header:after {
    content: "";
    position: absolute;
    background: url("../../assets/images/icons/arrow-down.svg") no-repeat center;
    right: 40px;
    width: 16px;
    height: 9px;
    background-size: cover;
    transition: ease-in-out .3s
}

.logo-dropdown-new__header img {
    width: 72px;
    height: 72px
}

.logo-dropdown-new__title {
    color: #3a4454;
    font-size: 20px;
    font-weight: 700;
    line-height: 100%
}

.logo-dropdown-new__body {
    font-size: 16px;
    font-weight: 400;
    line-height: 150%;
    max-height: 0;
    overflow: hidden;
    transition: max-height ease-in-out .3s, padding .3s ease-in-out
}

@media(min-width: 769px) {
    .logo-dropdown-new__body {
        padding: 0 36px 0px 36px
    }
}

@media(max-width: 768px) {
    .logo-dropdown-new__body {
        padding: 0 16px 0px 16px
    }
}

.logo-dropdown-new__body .editor-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    word-break: break-word
}

.logo-dropdown-new__body a {
    color: #219963;
    font-weight: 700;
    text-decoration: underline
}

.logo-dropdown-new__body a:hover {
    color: #007953;
    text-decoration: underline
}

.logo-dropdown-new__body ul,
.logo-dropdown-new__body ol {
    list-style: auto;
    padding-left: 15px
}

.page-links-new {
