    }

    .steps-new__card:after {
        height: 55px;
        width: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        content: url('data:image/svg+xml,<svg width="11" height="18" viewBox="0 0 11 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 17L9.44753 9.75926C9.91314 9.36016 9.91315 8.63984 9.44753 8.24074L1 1" stroke="%2359D1FF" stroke-width="2" stroke-linecap="round"/></svg>');
        position: absolute;
        top: 50%;
        right: -39px;
        background-color: #262f40;
        border-radius: 50%;
        z-index: 2;
        transform: translate(0, -50%)
    }

    .steps-new__card:first-child:before {
        display: none
    }

    .steps-new__card:last-child:after {
        display: none
    }
}

@media(min-width: 992px) {
    .steps-new__card:after {
        height: 55px;
        width: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        content: url('data:image/svg+xml,<svg width="11" height="18" viewBox="0 0 11 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 17L9.44753 9.75926C9.91314 9.36016 9.91315 8.63984 9.44753 8.24074L1 1" stroke="%2359D1FF" stroke-width="2" stroke-linecap="round"/></svg>');
        position: absolute;
        top: 50%;
        margin-top: -22.5px;
        right: -40px;
        background-color: #262f40;
        padding-left: 3px;
        border-radius: 50%;
        z-index: 1
    }

    .steps-new__card:first-child:before {
        display: none
    }

