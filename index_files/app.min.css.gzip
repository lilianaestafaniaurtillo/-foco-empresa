.steps-new {
    background-color: var(--background-color);
    background-image: var(--background-image);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center
}

@media(min-width: 992px) {
    .steps-new {
        margin: var(--margins-top) auto var(--margins-bottom) auto;
        padding-top: var(--padding-top);
        padding-bottom: var(--padding-bottom)
    }
}

@media(max-width: 991px) {
    .steps-new {
        margin-top: var(--margin-top--mobile);
        margin-bottom: var(--margin-bottom--mobile);
        padding-top: var(--padding-top--mobile);
        padding-bottom: var(--padding-bottom--mobile)
    }
}

.steps-new.steps-new--image {
    position: relative
}

.steps-new.steps-new--image .container {
    position: relative;
    z-index: 1
}

.steps-new__header h1,
.steps-new__header h2,
.steps-new__header h3,
.steps-new__header h4,
.steps-new__header h5,
.steps-new__header h6 {
    color: #fff;
    text-align: center;
    font-size: 40px;
    font-weight: 300;
    line-height: 100%
}

.steps-new__inner-wrapper {
    display: flex;
    gap: 24px;
    margin-top: 48px
}

@media(min-width: 1251px) {
    .steps-new__inner-wrapper {
        justify-content: center
    }
}

@media(max-width: 1250px) {
    .steps-new__inner-wrapper {
        overflow-x: scroll;
        -ms-overflow-style: none;
        scrollbar-width: none
    }

    .steps-new__inner-wrapper::-webkit-scrollbar {
        display: none
    }
}

@media(max-width: 991px) {
    .steps-new__inner-wrapper {
        flex-wrap: nowrap;
        padding: 30px 15px
    }
}

.steps-new__inner-wrapper.color-green .steps-new__step-content a {
    color: #219963
}

.steps-new__inner-wrapper.color-blue .steps-new__step-content a {
    color: #1a61ab
}

.steps-new__step-counter {
    color: #3a4454;
    font-size: 24px;
    font-weight: 700;
    line-height: 100%
}

.steps-new__step-title {
    color: #3a4454;
    font-size: 30px;
    font-weight: 300;
    line-height: 100%
}

.steps-new__step-content {
    color: #4a5264;
    font-size: 16px;
    font-weight: 400;
    line-height: 150%;
    margin-top: 24px
}

.steps-new__step-content a {
    font-weight: 700;
    text-decoration-line: underline;
    transition: ease-in-out .3s
}

.steps-new__step-content a:hover {
    text-decoration: underline;
    font-weight: 900;
    text-decoration-thickness: 2px
}

.steps-new__image-wrapper {
