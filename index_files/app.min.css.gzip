.block.grid-accordions-with-images .formatted-text p a:not(.button):after,
.block.grid-accordions-with-images .formatted-text li a:not(.button):after {
    transition: opacity 125ms ease-in-out, visibility 125ms ease-in-out;
    border-bottom: 1.5px solid #219963;
