.block.general-text-buttons {
    overflow: hidden
}

.block.general-text-buttons :first-child {
    margin-top: 0 !important
}

.block.general-text-buttons :last-child {
    margin-bottom: 0 !important
}

.block.general-text-buttons .formatted-text :first-child {
    margin-top: 0 !important
}

.block.general-text-buttons .formatted-text :last-child {
    margin-bottom: 0 !important
}

.block.general-text-buttons .formatted-text h1 {
    font-size: 40px;
    font-weight: 300
}

.block.general-text-buttons .formatted-text h2 {
    font-size: 34px;
    font-weight: 300
}

.block.general-text-buttons .formatted-text h3 {
    font-size: 30px;
    font-weight: 300
}

.block.general-text-buttons .formatted-text h4,
.block.general-text-buttons .formatted-text h5 {
    font-size: 20px;
    font-weight: 700
}

.block.general-text-buttons .formatted-text h6 {
    font-size: 16px;
    font-weight: 700
}

.block.general-text-buttons .formatted-text h1,
.block.general-text-buttons .formatted-text h2,
.block.general-text-buttons .formatted-text h3,
.block.general-text-buttons .formatted-text h4,
.block.general-text-buttons .formatted-text h5,
.block.general-text-buttons .formatted-text h6 {
    color: #3a4454
}

.block.general-text-buttons .formatted-text h1,
.block.general-text-buttons .formatted-text h2,
.block.general-text-buttons .formatted-text h3,
.block.general-text-buttons .formatted-text h4,
.block.general-text-buttons .formatted-text h5,
.block.general-text-buttons .formatted-text h6,
.block.general-text-buttons .formatted-text ol,
.block.general-text-buttons .formatted-text ul,
.block.general-text-buttons .formatted-text p {
    margin: 1em 0
}

.block.general-text-buttons .formatted-text blockquote {
    font-size: 16px;
    color: #4a5264;
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
    margin: 1em 0;
    padding-left: 2em;
    border-left: 5px solid #dce1e9
}

.block.general-text-buttons .formatted-text ul.is-spaced li+li,
.block.general-text-buttons .formatted-text ol.is-spaced li+li {
    margin-top: 1em
}

.block.general-text-buttons .formatted-text ul,
.block.general-text-buttons .formatted-text menu,
.block.general-text-buttons .formatted-text dir {
    display: block;
    line-height: 1.5;
    list-style-type: disc;
    margin-block-end: 1em;
    margin-block-start: 1em;
    margin-inline-end: 0px;
    margin-inline-start: 0px;
    padding-inline-start: 30px
}

.block.general-text-buttons .formatted-text ol {
    display: block;
    line-height: 1.5;
    list-style-type: decimal;
    margin-block-end: 1em;
    margin-block-start: 1em;
    margin-inline-end: 0px;
    margin-inline-start: 0px;
    padding-inline-start: 30px
}

.block.general-text-buttons .formatted-text p,
.block.general-text-buttons .formatted-text li {
    color: #4a5264;
    font-family: "poppins", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5
}

.block.general-text-buttons .formatted-text p a:not(.button),
.block.general-text-buttons .formatted-text li a:not(.button) {
    color: #219963;
    display: inline-block;
    font-weight: 700;
    position: relative
}

.block.general-text-buttons .formatted-text p a:not(.button):after,
.block.general-text-buttons .formatted-text li a:not(.button):after {
    transition: opacity 125ms ease-in-out, visibility 125ms ease-in-out;
    border-bottom: 1.5px solid #219963;
    bottom: 0;
    content: "";
    display: block;
    height: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transform: translate3d(0, 0, 0);
    visibility: hidden;
    width: 100%
}

.block.general-text-buttons .formatted-text p a:not(.button):hover:after,
.block.general-text-buttons .formatted-text li a:not(.button):hover:after {
    opacity: 1;
    visibility: visible
}

.block.general-text-buttons .formatted-text li {
    padding-left: 5px
}

.block.general-text-buttons .has-bubbles {
    max-width: 600px;
    position: relative
}

.block.general-text-buttons .has-bubbles.right {
    float: right;
    margin-left: calc(100px + 2em);
    margin-bottom: 2em
}

@media(max-width: 991px) {
    .block.general-text-buttons .has-bubbles.right {
        float: none;
        margin-left: 0;
        margin-right: 0
    }
}

.block.general-text-buttons .has-bubbles.left {
    float: left;
    margin-right: calc(67.5px + 2em);
    margin-bottom: 2em
}

@media(max-width: 991px) {
    .block.general-text-buttons .has-bubbles.left {
        float: none;
        margin-left: 0;
        margin-right: 0
    }
}

@media(max-width: 991px) {
    .block.general-text-buttons .has-bubbles {
        max-width: 100%
    }

    .block.general-text-buttons .has-bubbles img {
        width: 100%;
        height: auto
    }
}

.block.general-text-buttons .has-bubbles:before {
    content: "";
    position: absolute;
    display: block;
    height: 100%;
    width: 100%;
    background: linear-gradient(to bottom, rgb(255, 255, 255) 0%, rgba(255, 255, 255, 0) 25%);
    z-index: 3
}

.block.general-text-buttons .has-bubbles img {
    border-bottom-left-radius: 50px;
    border-bottom-right-radius: 50px;
    display: block;
    position: relative;
    z-index: 2;
    max-width: 100%
}

.block.general-text-buttons .has-bubbles span.bubble {
    border-radius: 50%;
    content: "";
    display: block;
    position: absolute
}

.block.general-text-buttons .has-bubbles span.bubble:first-child {
    background: linear-gradient(135deg, rgb(84, 61, 184) 0%, rgb(0, 121, 83) 100%);
    height: clamp(50px, 20vw, 245px);
    left: 0;
    top: 50%;
    transform: translate3d(-35%, -50%, 0);
    width: clamp(50px, 20vw, 245px);
    z-index: 1
}

.block.general-text-buttons .has-bubbles span.bubble:last-child {
    background: linear-gradient(135deg, rgb(33, 153, 99) 0%, rgb(0, 60, 113) 100%);
    height: clamp(50px, 20vw, 135px);
    right: 0;
    top: clamp(10px, 5%, 10vw);
