.faq-new__mobile-scroll-wrapper.scroll-wrapper--active {
    margin-top: 50px
}

@media(max-width: 991px) {
    .faq-new__mobile-scroll-wrapper {
        overflow-x: scroll;
        -ms-overflow-style: none;
        scrollbar-width: none
    }

    .faq-new__mobile-scroll-wrapper::-webkit-scrollbar {
        display: none
    }
}

.faq-new__filter-wrapper {
    background: #fff;
    border-radius: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    position: relative;
    z-index: 12
}

@media(max-width: 991px) {
    .faq-new__filter-wrapper {
        width: max-content
    }
}

.faq-new__filter-wrapper.filters-centered {
    justify-content: center
}

.faq-new__filter {
    border-radius: 50px;
    border: 1px solid #a5adb4;
    background: #fff;
    color: #708090;
    font-size: 16px;
    font-weight: 700;
    line-height: 100%;
    padding: 16px 32px;
    cursor: pointer;
    transition: ease-in-out .3s
}

.faq-new__items {
    display: grid;
    align-items: start;
    gap: 36px
}

@media(min-width: 992px) {
    .faq-new__items {
        grid-template-columns: repeat(2, 1fr);
        margin-top: 40px
    }
}

@media(max-width: 991px) {
    .faq-new__items {
        grid-template-columns: repeat(1, 1fr);
        margin-top: 20px
    }
}

.faq-new__item {
    border-radius: 10px;
    border: 1px solid #dce1e9;
    background: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px 48px 24px 24px;
    cursor: pointer;
    position: relative;
    word-break: break-word
}

.faq-new__item:after {
    content: "";
    display: block;
    position: absolute;
    top: 32px;
    right: 24px;
    width: 16px;
    height: 10px;
    background: url(data:image/svg+xml;base64,);
    background-size: cover;
    transition: ease-in-out .3s
}

.faq-new__item.answer--active:after {
    transform: rotate(180deg)
}

.faq-new__item.answer--active .faq-new__answer-wrapper {
    max-height: 5000px
}

.faq-new__item.answer--active .faq-new__question-wrapper {
    padding-bottom: 12px
}

.faq-new__question-wrapper {
    padding-bottom: 0;
    transition: ease-in-out .3s
}

.faq-new__question {
    font-size: 18px;
    font-weight: 700;
    line-height: 110%
}

.faq-new__answer-wrapper {
    max-height: 0;
    overflow: hidden;
    transition: ease-in-out .3s
}

.faq-new__answer {
    color: #4a5264;
    font-size: 16px;
    font-weight: 400;
    line-height: 150%
}

.faq-new__pagination {
    margin-top: 80px
}

.faq-new__pagination-list {
    display: flex;
    justify-content: center
}

@media(min-width: 577px) {
    .faq-new__pagination-list {
        gap: 24px
    }
}

@media(max-width: 576px) {
    .faq-new__pagination-list {
        gap: 12px
    }
}

.faq-new__pagination-list .page-numbers {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 16px;
    line-height: 100%;
    color: #4a5264;
    transition: ease-in-out .3s
}

.faq-new__pagination-list .page-numbers.current,
.faq-new__pagination-list .page-numbers:hover {
    background: #007953;
    color: #fff
}

.faq-new__pagination-list .page-numbers.dots:hover {
    background: #fff;
    color: #4a5264
}

.faq-new__pagination-list .page-numbers.next:after,
.faq-new__pagination-list .page-numbers.prev:after {
    content: "";
    background-image: url("../../assets/images/icons/pagination-icon.svg");
    background-repeat: no-repeat;
    background-size: contain;
    width: 7px;
    height: 12px
}

.faq-new__pagination-list .page-numbers.next:hover,
.faq-new__pagination-list .page-numbers.prev:hover {
    background: rgba(0, 0, 0, 0)
}

.faq-new__pagination-list .page-numbers.next:hover:after,
.faq-new__pagination-list .page-numbers.prev:hover:after {
    color: #4a5264;
    background-image: url("../../assets/images/icons/pagination-hover-icon.svg")
}

.faq-new__pagination-list .page-numbers.next:after {
    transform: rotate(180deg)
}

.faq-new__pagination-list .page-numbers.next:hover:after {
    transform: unset
}

.faq-new__pagination-list .page-numbers.prev:hover:after {
    transform: rotate(180deg)
}

.faq-new__pagination-list.search-hide {
    display: none
}

