.block.simple-columns div[class^=columns-] {
    display: grid;
    grid-template-rows: 1fr;
    grid-column-gap: 35px;
    grid-row-gap: 35px
}

.block.simple-columns div[class^=columns-].columns-1 {
    grid-template-columns: 1fr
}

.block.simple-columns div[class^=columns-].columns-2 {
