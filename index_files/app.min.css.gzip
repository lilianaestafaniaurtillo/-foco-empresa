        margin: var(--margin-top-mobile, 0) 0 var(--margin-bottom-mobile, 0) 0
    }
}

.block.contact-card div.contact-card {
    border-radius: 15px;
    border: 1px solid #dce1e9;
    font-family: "poppins", sans-serif;
    margin-left: auto;
    margin-right: auto;
    max-width: 680px;
    padding: 35px 50px
}

@media(max-width: 768px) {
    .block.contact-card div.contact-card {
        padding: 25px
    }
}

.block.contact-card div.contact-card h4,
.block.contact-card div.contact-card p {
    margin: 5px 0
}

.block.contact-card div.contact-card h3 {
    color: #4a5264;
    font-size: 30px;
    font-weight: 300;
    line-height: 1;
    margin: 50px 0;
    text-align: center
}

@media(max-width: 768px) {
    .block.contact-card div.contact-card h3 {
        font-size: 24px;
        margin: 25px 0
    }
}

.block.contact-card div.contact-card h4 {
    color: #3a4454;
    font-family: poppins;
    font-size: 20px;
    font-weight: 700;
    line-height: 1
}

.block.contact-card div.contact-card p {
    color: #4a5264;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5
}

.block.contact-card div.contact-card p a {
    color: #219963;
    display: inline-block;
    font-weight: 700;
    position: relative
}

.block.contact-card div.contact-card p a:after {
    transition: opacity 125ms ease-in-out, visibility 125ms ease-in-out;
    border-bottom: 1.5px solid #219963;
    bottom: 0;
    content: "";
    display: block;
    height: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transform: translate3d(0, 0, 0);
    visibility: hidden;
    width: 100%
}

.block.contact-card div.contact-card p a:hover:after {
    opacity: 1;
    visibility: visible
}

.block.contact-card div.info {
    align-items: flex-start;
    display: flex;
    gap: 30px;
    justify-content: center
}

.block.contact-card div.info div.icon {
    display: block;
    flex-shrink: 0;
    height: 47.5px;
    width: 47.5px
}

.block.contact-card div.info div.icon img {
    display: block;
    height: 100%;
    width: 100%
}

.block.contact-card div.info div.details {
    flex-grow: 1;
    max-width: 210px
}

