.primary-button-blue {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 14px 36px;
    min-width: 120px;
    background: #1a61ab;
    border-radius: 50px;
    font-weight: 700;
    font-size: 16px;
    line-height: 125%;
    color: #fff;
    transition: .3s
}

.primary-button-blue:hover {
    color: #fff;
    background: #003c71
}

.primary-button-blue:active {
    background: #1a61ab
}

