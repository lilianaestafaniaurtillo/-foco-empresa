}

@media(max-width: 768px) {
    .block.cases-requirements-table h2 {
        font-size: 36px;
        margin: 50px 0
    }
}

.block.cases-requirements-table ul.legend {
    background-color: #f7f9fb;
    border-radius: 15px;
    border: 1px solid #dce1e9;
    display: grid;
    grid-column-gap: 50px;
    grid-row-gap: 50px;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 1fr;
    list-style: none;
    margin: 0 auto;
    max-width: 900px
}

.block.cases-requirements-table ul.legend li+li:after {
    background-color: #dce1e9;
    content: "";
    display: block;
    position: absolute
}

@media(min-width: 769px) {
    .block.cases-requirements-table ul.legend {
        padding: 25px 50px
    }

    .block.cases-requirements-table ul.legend li+li:after {
        height: calc(100% + 25px);
        left: -25.5px;
        width: 1px
    }
}

@media(max-width: 768px) {
    .block.cases-requirements-table ul.legend {
        padding: 25px 35px;
        grid-template-columns: repeat(1, 1fr)
    }

    .block.cases-requirements-table ul.legend li+li:after {
        height: 1px;
        top: -25.5px;
        width: calc(100% + 25px);
        left: -12.5px
    }
}

.block.cases-requirements-table ul.legend li {
    align-items: center;
    display: flex;
    gap: 25px;
    justify-content: center;
    position: relative
}

@media(max-width: 768px) {
    .block.cases-requirements-table ul.legend li {
        justify-content: flex-start
    }
}

.block.cases-requirements-table ul.legend li span {
    color: #3a4454;
    font-family: "poppins", sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25
}

.block.cases-requirements-table ul.legend img {
    display: block;
    height: 45px;
    object-fit: contain;
    width: 45px
}

.block.cases-requirements-table div#tabs {
    margin: 50px 0;
    position: relative
}

.block.cases-requirements-table div#tabs ul[data-triggers] {
    background-color: #f5f5f5;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border: 1px solid #dce1e9;
    display: flex;
    list-style: none;
    margin: 0;
    overflow: auto;
    padding: 0
}

.block.cases-requirements-table div#tabs ul[data-triggers] li[data-index] {
    transition: background-color 125ms ease-in-out, color 125ms ease-in-out;
    cursor: pointer;
    flex-grow: 1;
    padding: 15px 30px;
    text-align: center;
    user-select: none;
    white-space: nowrap;
    color: #708090;
    font-weight: 700
}

.block.cases-requirements-table div#tabs ul[data-triggers] li[data-index]:hover,
.block.cases-requirements-table div#tabs ul[data-triggers] li[data-index].is-selected {
    background-color: #fff;
    color: #219963
}

.block.cases-requirements-table div#tabs ul[data-triggers] li+li {
    border-left: 1px solid #dce1e9
}

.block.cases-requirements-table div#tabs ul[data-tabs] {
    width: 100%;
    list-style: none;
    margin: 0;
    border-bottom: 1px solid #dce1e9;
    border-left: 1px solid #dce1e9;
    border-right: 1px solid #dce1e9;
    position: relative
}

.block.cases-requirements-table div#tabs ul[data-tabs] li[data-index] {
    transition: opacity 125ms linear, visibility 125ms linear;
    opacity: 0;
    overflow-x: auto;
    overflow-y: hidden;
    pointer-events: none;
    position: absolute;
    top: 0;
    visibility: hidden;
    width: 100%;
    -ms-overflow-style: none;
    scrollbar-width: none
}

.block.cases-requirements-table div#tabs ul[data-tabs] li[data-index]::-webkit-scrollbar {
    display: none
}

.block.cases-requirements-table div#tabs ul[data-tabs] li[data-index].is-selected {
    opacity: 1;
    pointer-events: all;
    position: relative;
    visibility: visible
}

.block.cases-requirements-table table {
    border-collapse: collapse;
    width: 100%
}

.block.cases-requirements-table table thead tr td {
    background-color: #219963;
    padding: 15px 30px;
    font-family: "poppins", sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    box-sizing: border-box;
    text-align: center
}

.block.cases-requirements-table table thead tr td img {
    width: 32px;
    height: 32px;
    display: block
}

.block.cases-requirements-table table thead tr td:nth-child(1) {
    width: 280px;
    min-width: 200px
}

.block.cases-requirements-table table thead tr td:nth-child(2) {
    min-width: 500px
}

.block.cases-requirements-table table thead tr td:nth-child(3),
.block.cases-requirements-table table thead tr td:nth-child(4),
.block.cases-requirements-table table thead tr td:nth-child(5) {
