.compare-three-cards-new__popup {
    background: #fff;
    padding: 37px 0 33px;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 250px;
    z-index: 90;
    box-shadow: 0px -15px 60px rgba(15, 35, 52, .15);
    transform: translateY(250px);
    transition: .3s
}

.compare-three-cards-new__popup.active {
    transform: translateY(0)
}

.compare-three-cards-new__popup.active .compare-three-cards-new__popup-inner-close {
    top: -55px
}

.compare-three-cards-new__popup.active.collapsed {
    transform: translateY(210px) !important
}

.compare-three-cards-new__popup.active.collapsed .compare-three-cards-new__popup-inner-close {
    transform: scale(1, -1)
}

.compare-three-cards-new__popup .container {
    position: relative
}

.compare-three-cards-new__popup-inner {
