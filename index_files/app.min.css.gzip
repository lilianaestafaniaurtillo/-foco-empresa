    background: #fff;
    border: 1px solid #dce1e9;
    border-top: none;
    max-width: 375px;
    width: 100%
}

.three-column-block-new__post-image {
    border-radius: 10px 10px 0 0;
    max-width: 100%
}

@media(max-width: 991px) {
    .three-column-block-new__post-image {
        width: 100%;
        object-fit: cover
    }
}

.three-column-block-new__title {
    font-size: 20px;
    font-weight: 700;
    line-height: 100%;
    margin-bottom: 16px;
    color: #3a4454
}

.three-column-block-new__content {
    font-size: 16px;
    line-height: 150%;
    margin-bottom: 13px;
    color: #4a5264;
    font-weight: 400
}

.three-column-block-new__post-content {
    padding: 24px 26px 34px 26px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between
}

.three-column-block-new__btn {
    text-decoration: underline;
    color: #219963;
    text-underline-offset: 5px;
    font-size: 16px;
    font-weight: 700;
    line-height: 150%
}

.three-column-block-new__btn:hover {
    text-decoration: underline;
    font-weight: 900;
    text-decoration-thickness: 2px
}

.three-column-block-new__pagination-list {
    display: flex;
    justify-content: center;
    gap: 24px
}

.three-column-block-new__pagination-list .page-numbers {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 16px;
    line-height: 100%;
    color: #4a5264;
    transition: ease-in-out .3s
}

.three-column-block-new__pagination-list .page-numbers.current,
.three-column-block-new__pagination-list .page-numbers:hover {
    background: #219963;
    color: #fff
}

.three-column-block-new__pagination-list .page-numbers.dots:hover {
    background: #fff;
    color: #4a5264
}

.three-column-block-new__pagination-list .page-numbers.next:after,
.three-column-block-new__pagination-list .page-numbers.prev:after {
    content: "";
    background-image: url("../../assets/images/icons/pagination-icon.svg");
    background-repeat: no-repeat;
    background-size: contain;
    width: 7px;
    height: 12px
}

.three-column-block-new__pagination-list .page-numbers.next:hover,
.three-column-block-new__pagination-list .page-numbers.prev:hover {
    background: #fff
}

.three-column-block-new__pagination-list .page-numbers.next:hover:after,
.three-column-block-new__pagination-list .page-numbers.prev:hover:after {
    color: #4a5264;
    background-image: url("../../assets/images/icons/pagination-hover-icon.svg")
}

.three-column-block-new__pagination-list .page-numbers.next:after {
    transform: rotate(180deg)
}

.three-column-block-new__pagination-list .page-numbers.next:hover:after {
    transform: unset
}

.three-column-block-new__pagination-list .page-numbers.prev:hover:after {
    transform: rotate(180deg)
}

.three-column-block-new__pagination-list.search-hide {
    display: none
}

@media(min-width: 769px) {
    .vertical-scroll-new {
        padding: var(--padding-top) 0 var(--padding-bottom) 0;
        margin: var(--margin-top) 0 var(--margin-bottom) 0
    }
}

@media(max-width: 768px) {
    .vertical-scroll-new {
        padding: var(--padding-top--mobile) 0 var(--padding-bottom--mobile) 0;
        margin: var(--margin-top--mobile) 0 var(--margin-bottom--mobile) 0
    }
}

.vertical-scroll-new__slider-wrapper .swiper {
    width: 100%;
    height: 480px;
    transition: 500ms all ease
}

.vertical-scroll-new__slider-wrapper .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden
}

@media(min-width: 1201px) {
    .vertical-scroll-new__slider-wrapper .swiper-slide {
        gap: 148px
    }
}

@media(max-width: 1200px) {
    .vertical-scroll-new__slider-wrapper .swiper-slide {
        gap: 30px
    }
}

@media(max-width: 768px) {
    .vertical-scroll-new__slider-wrapper .swiper-slide {
        flex-direction: column
    }
}

.vertical-scroll-new__image-wrapper {
    max-width: 476px
}

@media(min-width: 769px) {
    .vertical-scroll-new__slide-image {
        max-width: 100%;
        height: auto
    }
}

@media(max-width: 768px) {
    .vertical-scroll-new__slide-image {
        height: 250px;
        width: auto
    }
}

.vertical-scroll-new__content-wrapper {
    max-width: 442px;
    width: 100%
}

.vertical-scroll-new__content-wrapper h1,
.vertical-scroll-new__content-wrapper h2,
.vertical-scroll-new__content-wrapper h3,
.vertical-scroll-new__content-wrapper h4,
.vertical-scroll-new__content-wrapper h5,
.vertical-scroll-new__content-wrapper h6 {
    font-size: 40px;
    font-weight: 300;
    line-height: 100%;
    color: #3a4454;
    margin-bottom: 32px
}

.vertical-scroll-new__content-wrapper p {
    font-size: 16px;
    line-height: 150%;
    color: #4a5264
}

.vertical-scroll-new__content-wrapper p:not(:last-child) {
    margin-bottom: 36px
}

.vertical-scroll-new__content-wrapper p a {
    padding: 14px 36px;
    min-width: 120px;
    background: #007953;
    border-radius: 50px;
    font-weight: 700;
    font-size: 16px;
    line-height: 125%;
    color: #fff;
    transition: .3s
}

.vertical-scroll-new__content-wrapper p a:hover {
    color: #fff;
    background: #219963
}

.vertical-scroll-new__content-wrapper ul {
    list-style: disc;
    padding-left: 25px
}

.vertical-scroll-new__content-wrapper ul li {
    color: #748994;
    font-size: 16px;
    font-weight: 400;
    line-height: 150%
}

.vertical-scroll-new__slide-icon {
    margin-bottom: 35px
}

.videos-new {
    background: var(--background)
}

@media(min-width: 769px) {
    .videos-new {
        padding: var(--padding-top) 0 var(--padding-bottom) 0;
        margin: var(--margin-top--mobile) 0 var(--margin-bottom--mobile) 0
    }
}

@media(max-width: 768px) {
    .videos-new {
        padding: var(--padding-top--mobile) 0 var(--padding-bottom--mobile) 0;
        margin: var(--margin-top--mobile) 0 var(--margin-bottom--mobile) 0
    }
}

.videos-new.color-theme-green .videos-new__video-title,
.videos-new.color-theme-green .videos-new__bottom-link {
    color: #219963
}

.videos-new.color-theme-blue .videos-new__video-title,
.videos-new.color-theme-blue .videos-new__bottom-link {
    color: #1a61ab
}

.videos-new__title {
    color: #3a4454;
    text-align: center;
    font-weight: 300
}

@media(min-width: 769px) {
    .videos-new__title {
        font-size: 40px;
        line-height: 100%;
        margin-bottom: 61px
    }
}

@media(max-width: 768px) {
    .videos-new__title {
        font-size: 20px;
        line-height: 110%;
        margin-bottom: 30px
    }
}

.videos-new__video-wrapper {
    gap: 36px;
    display: flex;
    max-width: 1220px
}

@media(min-width: 577px) {
    .videos-new__video-wrapper {
        justify-content: center;
        flex-wrap: wrap
    }
}

@media(max-width: 576px) {
    .videos-new__video-wrapper {
        overflow-x: auto;
        overflow-y: hidden;
        -ms-overflow-style: none;
        scrollbar-width: none
    }

    .videos-new__video-wrapper::-webkit-scrollbar {
        display: none
    }
}

.videos-new__videos {
    width: 215px
}

.videos-new__video-embed {
    display: flex;
    flex-direction: column;
    gap: 16px;
    cursor: pointer
}

.videos-new__video-embed:hover .videos-new__thumbnail-wrapper::after {
    opacity: 40%
}

.videos-new__thumbnail-wrapper {
    position: relative
}

.videos-new__thumbnail-wrapper:before {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    content: "";
    background: rgba(0, 0, 0, .2);
    width: 100%;
    height: 100%
}

.videos-new__thumbnail-wrapper:after {
    content: "";
    display: block;
    width: 48px;
    height: 45px;
    background: url("../../assets/images/icons/play-button.svg") no-repeat center center;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: opacity .3s ease-in-out
}

.videos-new__video-content {
    display: flex;
    flex-direction: column;
    gap: 16px
}

.videos-new__video-title {
    font-size: 24px;
    font-weight: 300;
    line-height: 100%
}

.videos-new__video-text {
    color: #4a5264;
    font-size: 16px;
    font-weight: 400;
    line-height: 150%
}

.videos-new__iframe-wrapper {
    display: none;
    padding: 0 15px
}

.videos-new__iframe-wrapper.iframe-visible {
    position: fixed;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(24, 24, 27, .98);
    z-index: 9999
}

@media(max-width: 991px) {
    .videos-new__iframe-wrapper iframe {
        max-width: 960px;
        width: 100%
    }
}

@media(min-width: 577px) {
    .videos-new__bottom-wrapper {
        margin-top: 112px
    }
}

@media(max-width: 576px) {
    .videos-new__bottom-wrapper {
        margin-top: 50px
    }
}

.videos-new__bottom-link {
    font-size: 16px;
    font-weight: 700;
    line-height: 150%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px
}

.videos-new__bottom-link:hover {
    text-decoration: underline
}

.videos-new__bottom-link:before {
    content: "";
    display: block;
    max-width: 32px;
    width: 100%;
    height: 32px;
    background: var(--bottom-icon) no-repeat center center
}

.videos-new__close-icon {
    position: absolute;
    top: 90px;
    cursor: pointer;
    width: 40px;
    height: 40px
}

@media(min-width: 769px) {
    .videos-new__close-icon {
        right: 90px
    }
}

@media(max-width: 768px) {
    .videos-new__close-icon {
        right: 0
    }
}