.block.featured-image .is-responsive-16-5 {
    height: 0;
    padding-bottom: 31.25%;
    position: relative;
    overflow: hidden;
    border-radius: 10px
}

.block.featured-image .is-responsive-16-5>* {
    border: 0;
    display: block;
    height: 100%;
    left: 0;
    object-fit: cover;
    object-position: center center;
    position: absolute;
    top: 0;
    width: 100%
}

@media(max-width: 768px) {
    .block.featured-image .is-responsive-16-5 {
        display: none !important
    }
}

.block.featured-image .is-responsive-4-6 {
    height: 0;
    padding-bottom: 150%;
    position: relative;
    padding-bottom: 31% !important;
    overflow: hidden;
    border-radius: 10px
}

.block.featured-image .is-responsive-4-6>* {
    border: 0;
    display: block;
    height: 100%;
    left: 0;
    object-fit: cover;
    object-position: center center;
    position: absolute;
    top: 0;
    width: 100%
}

@media(min-width: 769px) {
