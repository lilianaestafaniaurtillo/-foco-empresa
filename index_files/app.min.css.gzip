    }
}

.block.sliding-tabs div#sliding-tabs ul[data-triggers] li[data-index] {
    transition: border-color 125ms ease-in-out, color 125ms ease-in-out;
    align-items: center;
    background: #fff;
    border-radius: 10px;
    border: 1px solid #dce1e9;
    box-sizing: border-box;
    color: #219963;
    cursor: pointer;
    display: flex;
    font-family: "poppins", sans-serif;
    font-size: 30px;
    font-weight: 300;
    height: 100%;
    line-height: 1;
    overflow: hidden;
    padding: 55px 35px;
    user-select: none
}

.block.sliding-tabs div#sliding-tabs ul[data-triggers] li[data-index]:before {
    transition: opacity 125ms ease-in-out;
    background: linear-gradient(to right, rgb(0, 121, 83) 0%, rgb(0, 60, 113) 100%);
    content: "";
    height: 100%;
    left: 0;
    opacity: 0;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: -1
}

.block.sliding-tabs div#sliding-tabs ul[data-triggers] li[data-index]:hover,
.block.sliding-tabs div#sliding-tabs ul[data-triggers] li[data-index].is-selected {
    border-color: rgba(255, 255, 255, 0);
    color: #fff
}

.block.sliding-tabs div#sliding-tabs ul[data-triggers] li[data-index]:hover:before,
.block.sliding-tabs div#sliding-tabs ul[data-triggers] li[data-index].is-selected:before {
    opacity: 1
}

@media(max-width: 991px) {
    .block.sliding-tabs div#sliding-tabs ul[data-triggers] li[data-index] {
        padding: 35px 25px
    }
}

@media(max-width: 768px) {
    .block.sliding-tabs div#sliding-tabs ul[data-triggers] li[data-index] {
        font-size: 24px;
        padding: 35px 25px
    }
}

.block.sliding-tabs div#sliding-tabs ul[data-tabs] {
    list-style: none;
    margin: 100px 0;
    position: relative;
    width: 100%;
    overflow: hidden
}

@media(max-width: 991px) {
    .block.sliding-tabs div#sliding-tabs ul[data-tabs] {
        margin: 50px 0
    }
}

@media(max-width: 768px) {
    .block.sliding-tabs div#sliding-tabs ul[data-tabs] {
        margin: 35px 0
    }
}

.block.sliding-tabs div#sliding-tabs ul[data-tabs] li[data-index] {
    transition: opacity 125ms linear, visibility 125ms linear;
    opacity: 0;
    overflow-x: auto;
    overflow-y: hidden;
    pointer-events: none;
    pointer-events: none;
    position: absolute;
    top: 0;
    visibility: hidden;
    width: 100%
}

.block.sliding-tabs div#sliding-tabs ul[data-tabs] li[data-index].is-selected {
    opacity: 1;
    pointer-events: all;
    pointer-events: all;
    position: relative;
    visibility: visible
}

