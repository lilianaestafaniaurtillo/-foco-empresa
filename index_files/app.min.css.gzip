}

.block.cases-requirements-table table tbody li {
    display: flex;
    gap: 15px
}

.block.cases-requirements-table table tbody li:before {
    flex-shrink: 0;
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #4a5264;
    position: relative;
    top: 9.5px;
    transform: translate3d(0, 0, 0)
}

.block.cases-requirements-table table tbody tr td {
    padding: 15px;
    border-top: 1px solid #dce1e9;
    box-sizing: border-box
}

.block.cases-requirements-table table tbody tr td:nth-child(3),
.block.cases-requirements-table table tbody tr td:nth-child(4),
.block.cases-requirements-table table tbody tr td:nth-child(5) {
    text-align: center
}

.block.cases-requirements-table table tbody tr td+td {
    border-left: 1px solid #dce1e9
}

.block.cases-requirements-table table tbody tr img {
    display: block;
    margin: 0 auto
}

